# Konfigurasi server TasteQuest. Salin ke .env, atau jalankan `npm run setup` yang membuat .env dengan secrets acak.
# Jangan commit .env (sudah ada di .gitignore).

# 0.0.0.0 = bisa diakses ESP8266 & perangkat lain di jaringan lokal.
HOST=0.0.0.0
PORT=3000

# File SQLite (relatif ke folder proyek, atau path absolut). Data bertahan setelah restart.
DB_PATH=data/tastequest.db

# Password login operator dashboard (min. 8 karakter).
OPERATOR_PASSWORD=ganti-password-operator

# Token yang dikirim ESP8266 sebagai "Authorization: Bearer <token>" (16–128 karakter A-Z a-z 0-9 _ -).
# Harus sama dengan DEVICE_TOKEN di firmware/include/secrets.h.
DEVICE_TOKEN=ganti-dengan-token-acak-panjang

# Perangkat ditandai OFFLINE setelah tidak mengirim data selama ini (ms). Heartbeat firmware tiap 5 dtk.
DEVICE_OFFLINE_MS=15000

# Lama sesi login operator (jam).
SESSION_TTL_HOURS=12
