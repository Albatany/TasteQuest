{
  "name": "tastequest",
  "version": "3.0.0",
  "private": true,
  "description": "TasteQuest — ProxiRush + Exhibition Rating + dashboard IoT real-time. HMIF UNJA × FST Market Day 2026. © Muhammad Aziz Syah Dani 2026",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "dev": "npm run dev:server & npm run dev:web",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:fw": "g++ -std=c++17 -Wall -Wextra -Werror -Ifirmware/include firmware/test/test_logic.cpp -o data/test_logic && ./data/test_logic",
    "e2e": "playwright test",
    "fw:build": "pio run -d firmware",
    "oled:preview": "node scripts/oled-preview.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:fw && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "express": "5.3.0",
    "pixelarticons": "2.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
